# ===================================================================
# FITVERSE ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Copy this file to .env and fill in your actual values.
# NEVER commit your real .env file or credentials to Git!
# ===================================================================

# -------------------------------------------------------------------
# FRONTEND CONFIGURATION (Vite React)
# -------------------------------------------------------------------
# Note: VITE_ variables are bundled into client-side JavaScript.
# NEVER place secret API keys or passwords in VITE_ variables.

# Local Backend API URL:
VITE_API_BASE_URL=http://localhost:8080/api

# Production Backend API URL (set on Vercel/Netlify once backend is deployed):
# VITE_API_BASE_URL=https://fitverse-backend.onrender.com/api

# -------------------------------------------------------------------
# BACKEND CONFIGURATION (Java Spring Boot)
# -------------------------------------------------------------------
# Local Server Port
PORT=8080

# Database Configuration (MySQL)
# Local MySQL:
DB_URL=jdbc:mysql://localhost:3306/fitverse_db?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=your_local_mysql_password

# Production Database (Cloud MySQL, e.g. Aiven, Clever Cloud, or Railway):
# DB_URL=jdbc:mysql://your-cloud-host:3306/fitverse_db?useSSL=true&serverTimezone=UTC
# DB_USERNAME=your_cloud_user
# DB_PASSWORD=your_cloud_password

# JWT Security Secret (must be a strong 256-bit secret string):
JWT_SECRET=FitverseSuperSecretKeyForJwtTokenGenerationMinimum256BitsLong2026!
JWT_EXPIRATION_MS=86400000

# CORS Configuration (Allowed frontend origin):
# Local:
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Production (set to your deployed frontend URL):
# CORS_ALLOWED_ORIGINS=https://fitverse.vercel.app

# Optional AI Assistant (Google Gemini API):
# If empty, FitBot operates in deterministic smart demo mode for free.
GEMINI_API_KEY=
